
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String?
  role            Role      @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  buses             Bus[]
  admins            User[]           @relation("OwnerAdmins")
  commissionTiers   CommissionTier[]
  discounts         Discount[]
}

model CommissionTier {
  id      String          @id @default(cuid())
  ownerId String
  minSales Int
  maxSales Int
  type    CommissionType
  value   Float
  owner   BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  routes   Route[]
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Location {
  id                 String  @id @default(cuid())
  name               String  @unique
  routesOrigin       Route[] @relation("OriginRoutes")
  routesDestination  Route[] @relation("DestinationRoutes")
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

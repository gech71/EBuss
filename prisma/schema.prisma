
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================= //
//                      AUTH                         //
// ================================================= //
model User {
  id             String  @id @unique
  email          String  @unique
  hashed_password String?
  name           String
  role           Role
  busOwnerId     String?
  busOwner       BusOwner? @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions       Session[]
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// This model is for rate limiting login attempts
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// ================================================= //
//                 BUSINESS LOGIC                    //
// ================================================= //

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  admins            User[]           @relation("BusOwnerAdmins")
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId  String
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  routes   Route[]
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId    String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("RouteOrigins", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("RouteDestinations", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?

  @@index([originId, destinationId, departureTime])
}

model Location {
  id               String  @id @default(cuid())
  name             String
  originRoutes     Route[] @relation("RouteOrigins")
  destinationRoutes Route[] @relation("RouteDestinations")
  owner            BusOwner @relation(fields: [ownerId], references: [id])
  ownerId          String

  @@unique([name, ownerId])
}


model Booking {
  id             String       @id @default(cuid())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references
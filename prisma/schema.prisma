// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id
  email           String   @unique
  name            String
  hashed_password String?
  role            Role     @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  sessions Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                String           @id
  name              String           @unique
  bankAccountNumber String           @unique
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  admins            User[]           @relation("OwnerAdmins")
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id         String   @id @default(cuid())
  busOwnerId String
  minSales   Decimal
  maxSales   Decimal
  type       CommissionType
  value      Decimal
  busOwner   BusOwner @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
}

model SeatLayout {
  id        String   @id @default(cuid())
  rows      Int
  cols      Int
  seats     Seat[]
  bus       Bus?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Seat {
  id         String   @id @default(cuid())
  layoutId   String
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Location {
  id             String  @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin   Route[] @relation("Origin")
  routesDest     Route[] @relation("Destination")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([name, ownerId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime  @db.Timestamptz(3)
  arrivalTime   DateTime  @db.Timestamptz(3)
  price         Decimal
  busId         String
  origin        Location  @relation("Origin", fields: [originId], references: [id])
  destination   Location  @relation("Destination", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

model Booking {
  id              String         @id @default(cuid())
  passengerName   String
  passengerPhone  String
  totalPrice      Decimal
  routeId         String
  route           Route          @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
  bookingTime     DateTime       @default(now()) @db.Timestamptz(3)
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  expiresAt       DateTime?      @db.Timestamptz(3)
  payments        Payment[]

  @@index([passengerPhone])
}

model BookedSeat {
  id         String  @id @default(cuid())
  bookingId  String
  seatNumber String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime       @db.Timestamptz(3)
  endDate   DateTime       @db.Timestamptz(3)
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([ipAddress, timestamp])
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([ipAddress, timestamp])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  ipAddress   String?
  actionType  String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

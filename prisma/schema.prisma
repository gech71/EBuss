
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String    @id @unique
  name            String
  email           String    @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("admins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
    id        String   @id @default(cuid())
    ipAddress String
    timestamp DateTime @default(now())
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("admins")
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  owner    BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  routes   Route[]
  seatLayoutId String  @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType
  layout      SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("origin", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("destination", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId    String?
}

model Location {
  id           String  @id @default(cuid())
  name         String
  owner        BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  originRoutes Route[] @relation("origin")
  destRoutes   Route[] @relation("destination")

  @@unique([name, ownerId])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  paymentStatus  String       @default("PENDING")
  payments       Payment[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Payment {
    id              String    @id @default(cuid())
    bookingId       String
    booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    amount          Decimal
    status          String    @default("PENDING") // PENDING, PAID, FAILED
    transactionId   String    @unique
    paymentToken    String?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
}


enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String
  role            Role        @default(USER)
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String            @id @default(cuid())
  name            String            @unique
  buses           Bus[]
  admins          User[]            @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  locations       Location[]
  discounts       Discount[]
}

model CommissionTier {
  id        String          @id @default(cuid())
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id                      String    @id @default(cuid())
  name                    String
  ownerId                 String
  owner                   BusOwner  @relation(fields: [ownerId], references: [id])
  originRoutes            Route[]   @relation("OriginRoutes")
  destinationRoutes       Route[]   @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
}

model SeatLayout {
  id      String  @id @default(cuid())
  rows    Int
  cols    Int
  seats   Seat[]
  bus     Bus?
}

model Seat {
  id            String    @id @default(cuid())
  layoutId      String
  layout        SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber    String
  status        SeatStatus @default(AVAILABLE)
  type          SeatType   @default(SEAT)
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id              String    @id @default(cuid())
  originId        String
  destinationId   String
  origin          Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination     Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime   DateTime
  arrivalTime     DateTime
  price           Decimal
  busId           String
  bus             Bus       @relation(fields: [busId], references: [id])
  bookings        Booking[]
  discountId      String?
  discount        Discount? @relation(fields: [discountId], references: [id])
}

model Discount {
  id        String          @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id])
}

model DiscountTier {
  id          String    @id @default(cuid())
  discountId  String
  discount    Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets  Int
  maxTickets  Int
  percentage Decimal
}

model Booking {
  id              String        @id @default(cuid())
  routeId         String
  route           Route         @relation(fields: [routeId], references: [id])
  totalPrice      Decimal
  bookingTime     DateTime      @default(now())
  passengerName   String
  passengerEmail  String?
  passengerPhone  String
  bookedSeats     BookedSeat[]
  payments        Payment[]
  status          BookingStatus @default(VALID)
  paymentStatus   PaymentStatus @default(PENDING)
}

model BookedSeat {
    id        String @id @default(cuid())
    bookingId String
    booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    seatNumber String
}

enum BookingStatus {
  VALID
  CANCELLED
}

model Payment {
    id              String          @id @default(cuid())
    bookingId       String
    booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    amount          Decimal
    status          PaymentStatus   @default(PENDING)
    transactionId   String          @unique
    paymentToken    String?
    createdAt       DateTime        @default(now())
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ipAddress   String
  timestamp   DateTime @default(now())
}


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id
  name                     String
  email                    String    @unique
  hashed_password          String?
  role                     Role
  busOwnerId               String?
  busOwner                 BusOwner? @relation("admins", fields: [busOwnerId], references: [id], onDelete: Restrict)
  sessions                 Session[]
  passwordChangeRequired   Boolean   @default(true)
  auditLogs                AuditLog[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                String           @id
  name              String           @unique
  bankAccountNumber String           @unique
  commissionTiers   CommissionTier[]
  buses             Bus[]
  admins            User[]           @relation("admins")
  discounts         Discount[]
  locations         Location[]
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  minSales   Int
  maxSales   Int
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

model Discount {
  id         String          @id @default(cuid())
  name       String
  type       DiscountType
  startDate  DateTime        @db.Date
  endDate    DateTime        @db.Date
  percentage Decimal?        @db.Decimal(5, 2)
  tiers      DiscountTier[]
  routes     Route[]
  ownerId    String
  owner      BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes   Route[]
  layoutId String     @unique
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Location {
  id               String  @id @default(cuid())
  name             String
  originRoutes     Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")
  ownerId          String
  owner            BusOwner @relation(fields: [ownerId], references: [id])

  @@unique([name, ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String   @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Route {
  id            String     @id @default(cuid())
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal    @db.Decimal(10, 2)
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  originId      String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Restrict)
  destinationId String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  discountId    String?
  discount      Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull)
  ticketType    TicketType @default(ONE_WAY)
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal       @db.Decimal(10, 2)
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  expiresAt      DateTime?
  payments       Payment[]

  @@index([passengerPhone])
}

model BookedSeat {
  id         String  @id @default(cuid())
  bookingId  String
  seatNumber String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  actionType  String
  description String   @db.Text
  createdAt   DateTime @default(now())
  ipAddress   String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  DATE_BASED
  TICKET_COUNT_BASED
}

enum BookingStatus {
  PENDING
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

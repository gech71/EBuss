
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  commissionTiers   CommissionTier[]
  admins            User[]            @relation("OwnerAdmins")
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  ownerId  String
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id                      String  @id @default(cuid())
  name                    String
  ownerId                 String
  owner                   BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin            Route[] @relation("OriginRoutes")
  routesDestination       Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layout    SeatLayout  @relation(fields: [busId], references: [id])
  busId     String      @unique
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id])
  seatNumber  String
  status      SeatStatus
  type        SeatType
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String       @id @default(cuid())
  routeId         String
  totalPrice      Decimal      @db.Decimal(10, 2)
  bookingTime     DateTime     @default(now())
  passengerName   String
  passengerEmail  String
  status          String       @default("VALID")
  route           Route        @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
}

model BookedSeat {
  id          String  @id @default(cuid())
  bookingId   String
  seatNumber  String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

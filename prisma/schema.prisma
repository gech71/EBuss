
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// AUTH MODELS
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String
  role            Role      @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}


// CORE APP MODELS
model Location {
  id           String   @id @default(cuid())
  name         String
  ownerId      String
  originRoutes Route[]  @relation("OriginRoutes")
  destRoutes   Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@map("locations")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  discounts       Discount[]
  
  @@map("bus_owners")
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layout    SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique

  @@map("buses")
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?

  @@map("seat_layouts")
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
  layout      SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String

  @@map("seats")
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal    @db.Decimal(10, 2)
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@map("routes")
}


model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
  paymentStatus  String       @default("PENDING") // e.g., PENDING, PAID, FAILED
  payments       Payment[]

  @@map("bookings")
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String

  @@map("booked_seats")
}


model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]

  @@map("discounts")
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@map("discount_tiers")
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  @@map("commission_tiers")
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// For rate limiting login attempts
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@map("login_attempts")
}


// For payment gateway integration
model Payment {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  transactionId String   @unique // The ID we send to the payment gateway
  paymentToken  String?  // The token we get back from the payment gateway
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payments")
}

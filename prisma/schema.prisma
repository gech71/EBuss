
generator client {
  provider = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerUsers", fields: [busOwnerId], references: [id])

  sessions Session[]

  @@map("users")
}

model Session {
	id        String   @id
	userId    String
	expiresAt DateTime
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}


model BusOwner {
  id              String   @id @default(cuid())
  name            String   @unique
  buses           Bus[]    @relation("OwnerBuses")
  admins          User[]   @relation("OwnerUsers")
  locations       Location[] @relation("OwnerLocations")
  discounts       Discount[] @relation("OwnerDiscounts")
  commissionTiers CommissionTier[]

  @@map("bus_owners")
}

model CommissionTier {
  id       String         @id @default(cuid())
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id])
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal

  @@map("commission_tiers")
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id              String   @id @default(cuid())
  name            String
  ownerId         String
  owner           BusOwner @relation("OwnerLocations", fields: [ownerId], references: [id])
  routesOrigin    Route[]  @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@map("locations")
}

model Bus {
  id       String    @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner  @relation("OwnerBuses", fields: [ownerId], references: [id])
  layout   SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  routes   Route[]
  seatLayoutId String @unique

  @@map("buses")
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?

  @@map("seat_layouts")
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType

  @@map("seats")
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])

  @@map("routes")
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED

  @@map("bookings")
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String

  @@map("booked_seats")
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation("OwnerDiscounts", fields: [ownerId], references: [id])

  @@map("discounts")
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal

  @@map("discount_tiers")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@map("login_attempts")
}

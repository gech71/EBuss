
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ENUMS
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}


// MODELS
model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
	id        String   @id
	expiresAt DateTime
	userId    String
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId])
}

model BusOwner {
  id              String   @id @default(cuid())
  name            String   @unique
  commissionTiers CommissionTier[]
  admins          User[]   @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Location {
  id               String  @id @default(cuid())
  name             String
  ownerId          String
  owner            BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin     Route[] @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes   Route[]
  layout   SeatLayout @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String @unique

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])

  @@index([busId])
  @@index([originId])
  @@index([destinationId])
  @@index([discountId])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerEmail String
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  totalPrice     Decimal
  status         BookingStatus @default(VALID)
  bookingTime    DateTime      @default(now())
  bookedSeats    BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@index([bookingId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

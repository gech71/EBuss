// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id
  email                   String    @unique
  name                    String
  hashed_password         String?
  role                    Role      @default(USER)
  busOwnerId              String?
  busOwner                BusOwner? @relation("OwnerUsers", fields: [busOwnerId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  sessions                Session[]
  passwordChangeRequired  Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fresh     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  commissionTiers   CommissionTier[]
  buses             Bus[]
  admins            User[]           @relation("OwnerUsers")
  locations         Location[]
  discounts         Discount[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  minSales   Int
  maxSales   Int
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
  owner      BusOwner       @relation(fields: [busOwnerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([busOwnerId])
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner   @relation(fields: [ownerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  layoutId  String?    @unique
  layout    SeatLayout?
  routes    Route[]
  busRoutes BusRoute[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
}

model SeatLayout {
  id      String @id @default(cuid())
  rows    Int
  cols    Int
  seats   Seat[]
  busId   String @unique
  bus     Bus    @relation(fields: [busId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Seat {
  id         String   @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  seatNumber String
  type       SeatType
  createdAt  DateTime @default(now())

  @@index([layoutId])
}

model Location {
  id             String    @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner  @relation(fields: [ownerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  originRoutes   Route[]   @relation("OriginRoutes")
  destRoutes     Route[]   @relation("DestinationRoutes")
  originBusRoutes BusRoute[] @relation("BusRouteOrigins")
  destBusRoutes   BusRoute[] @relation("BusRouteDestinations")
  createdAt      DateTime  @default(now())

  @@unique([name, ownerId])
  @@index([ownerId])
}

model BusRoute {
  id            String   @id @default(cuid())
  busId         String
  bus           Bus      @relation(fields: [busId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  originId      String
  origin        Location @relation("BusRouteOrigins", fields: [originId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  destinationId String
  destination   Location @relation("BusRouteDestinations", fields: [destinationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([busId, originId, destinationId])
  @@index([busId])
  @@index([originId])
  @@index([destinationId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  bookings      Booking[]
  tickets       Ticket[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ticketType              TicketType        @default(ONE_WAY)
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal?          @db.Decimal(10, 2)

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  tickets        Ticket[]
  paymentStatus  PaymentStatus @default(PENDING)
  expiresAt      DateTime?
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([routeId])
  @@index([passengerPhone])
}

model Ticket {
  id          String       @id @default(cuid())
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  routeId     String
  route       Route        @relation(fields: [routeId], references: [id], onUpdate: Cascade, onDelete: NoAction)
  seatNumber  String
  status      TicketStatus
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([bookingId])
  @@index([routeId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
}

model Discount {
  id         String         @id @default(cuid())
  name       String
  type       DiscountType
  percentage Decimal?       @db.Decimal(5, 2)
  startDate  DateTime
  endDate    DateTime
  tiers      DiscountTier[]
  routes     Route[]
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([name, ownerId])
  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@index([discountId])
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  ipAddress   String?
  actionType  String
  description String
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([actionType])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
  
  @@index([ipAddress, timestamp])
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
  
  @@index([ipAddress, timestamp])
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum TicketStatus {
  PENDING
  VALID
  USED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
  TICKET_COUNT_BASED
  DATE_BASED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

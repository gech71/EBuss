
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x"]
}

model User {
  id              String      @id @unique
  email           String      @unique
  name            String
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("BusOwnerAdmins")
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner   @relation(fields: [ownerId], references: [id])
  layoutId  String     @unique
  layout    SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
}

model Location {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes  Route[]  @relation("OriginRoutes")
  destRoutes    Route[]  @relation("DestinationRoutes")

  @@unique([ownerId, name])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  bookings      Booking[]
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         BookingStatus @default(VALID)
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}


enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

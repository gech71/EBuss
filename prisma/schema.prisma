
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String          @id @default(cuid())
  name            String          @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]          @relation("OwnerAdmins")
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model CommissionTier {
  id        String         @id @default(cuid())
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id           String  @id @default(cuid())
  name         String
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  ownerId      String

  @@unique([name, ownerId])
}

model Bus {
  id         String     @id @default(cuid())
  name       String
  capacity   Int
  routes     Route[]
  owner      BusOwner   @relation(fields: [ownerId], references: [id])
  ownerId    String
  layout     SeatLayout @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String     @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layout      SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String       @id @default(cuid())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
}

model BookedSeat {
    id String @id @default(cuid())
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    bookingId String
    seatNumber String
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

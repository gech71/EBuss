// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  hashed_password String?
  role            Role       @default(CUSTOMER)
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner?  @relation("OwnerUsers", fields: [busOwnerId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id               String           @id @default(cuid())
  name             String           @unique
  buses            Bus[]
  admins           User[]           @relation("OwnerUsers")
  commissionTiers  CommissionTier[]
  discounts        Discount[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model CommissionTier {
  id        String          @id @default(cuid())
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Float
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

model Location {
  id           String  @id @default(cuid())
  name         String  @unique
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  routes   Route[]
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId    String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  bookingTime    DateTime     @default(now())
}

model BookedSeat {
  id          String  @id @default(cuid())
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  seatNumber  String // e.g. "1A", "4C"
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  hashed_password String
  role          Role
  busOwnerId    String?
  busOwner      BusOwner? @relation(fields: [busOwnerId], references: [id])
  sessions      Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  discounts       Discount[]
  users           User[]
  commissionTiers CommissionTier[]
}

model CommissionTier {
  id         String          @id @default(cuid())
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Float
  ownerId    String
  owner      BusOwner        @relation(fields: [ownerId], references: [id])
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout @relation(fields: [seatLayoutId], references: [id])
  routes   Route[]
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id])
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id           String     @id @default(cuid())
  seatNumber   String
  status       SeatStatus
  type         SeatType
  seatLayoutId String
  seatLayout   SeatLayout @relation(fields: [seatLayoutId], references: [id])

  @@unique([seatLayoutId, seatNumber])
}

model Route {
  id            String    @id @default(cuid())
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Float
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  seatNumber String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

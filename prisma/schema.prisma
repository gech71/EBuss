// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================= //
//                  ENUMS & TYPES                    //
// ================================================= //
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED // Seat is part of a pending or paid booking
  LOCKED // Seat is unavailable for other reasons
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING // Awaiting payment
  VALID // Paid and valid for travel
  USED // Ticket has been scanned and used
  EXPIRED // Booking was not paid for in time
  CANCELLED // Booking was cancelled
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  DATE_BASED
  TICKET_COUNT_BASED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

// ================================================= //
//                 AUTHENTICATION                    //
// ================================================= //

model User {
  id                     String      @id
  email                  String      @unique
  name                   String
  hashed_password        String?
  role                   Role        @default(USER)
  passwordChangeRequired Boolean     @default(false)
  busOwnerId             String?
  busOwner               BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id], onDelete: SetNull)
  sessions               Session[]
  auditLogs              AuditLog[]
  loginAttempts          LoginAttempt[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  ipAddress String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ================================================= //
//                 BUSINESS LOGIC                    //
// ================================================= //

model BusOwner {
  id                  String           @id
  name                String           @unique
  bankAccountNumber   String           @unique
  commissionTiers     CommissionTier[]
  buses               Bus[]
  locations           Location[]
  discounts           Discount[]
  admins              User[]           @relation("BusOwnerAdmins")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  routes    Route[]
  busRoutes BusRoute[] // The routes this bus is allowed on

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
}

model Location {
  id                     String     @id @default(cuid())
  name                   String
  ownerId                String
  owner                  BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin           Route[]    @relation("RouteOrigin")
  routesDestination      Route[]    @relation("RouteDestination")
  busRoutesOrigin        BusRoute[] @relation("BusRouteOrigin")
  busRoutesDestination   BusRoute[] @relation("BusRouteDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
}

model Route {
  id            String   @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal  @db.Decimal(10, 2)
  busId         String
  bus           Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin        Location @relation("RouteOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination   Location @relation("RouteDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  bookings      Booking[]

  discountId              String?
  discount                Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  ticketType              TicketType @default(ONE_WAY)
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusRoute {
  id            String   @id @default(cuid())
  busId         String
  bus           Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  originId      String
  origin        Location @relation("BusRouteOrigin", fields: [originId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Location @relation("BusRouteDestination", fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([busId, originId, destinationId])
}


model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  totalPrice     Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  bookingTime    DateTime      @default(now())
  expiresAt      DateTime

  routeId     String
  route       Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookedSeats BookedSeat[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookedSeat {
  id         String  @id @default(cuid())
  seatNumber String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Discount {
  id        String          @id @default(cuid())
  name      String
  type      DiscountType
  startDate DateTime
  endDate   DateTime
  percentage Decimal?       @db.Decimal(5, 2)
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes    Route[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

   @@unique([ownerId, name])
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Decimal  @db.Decimal(5, 2)
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId  String
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales   Decimal        @db.Decimal(12, 2)
  maxSales   Decimal        @db.Decimal(12, 2)
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
}


// ================================================= //
//                    LOGGING                        //
// ================================================= //

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  userRole    Role?
  actionType  String
  description String   @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

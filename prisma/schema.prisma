// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("Admins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String
  commissionTiers   CommissionTier[]
  buses             Bus[]
  locations         Location[]
  admins            User[]           @relation("Admins")
  discounts         Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id           String  @id @default(cuid())
  name         String
  owner        BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  routes   Route[]
  seatLayoutId String   @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
  seatNumber String
  status     SeatStatus
  type       SeatType

  @@unique([layoutId, seatNumber])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId    String?
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model Booking {
  id             String        @id @default(cuid())
  route          Route         @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  passengerName  String
  passengerPhone String
  passengerEmail String?
  totalPrice     Decimal
  status         BookingStatus
  paymentStatus  PaymentStatus
  bookingTime    DateTime      @default(now())
  payments       Payment[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  seatNumber String
}

enum BookingStatus {
  PENDING
  VALID
  CANCELLED
  USED
}

model Payment {
  id              String        @id @default(cuid())
  booking         Booking       @relation(fields: [bookingId], references: [id])
  bookingId       String
  amount          Decimal
  status          PaymentStatus
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

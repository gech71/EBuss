
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  admins          User[]
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
}

model CommissionTier {
  id        String         @id @default(cuid())
  busOwner  BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal        @db.Decimal(10, 2)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model User {
  id              String      @id
  name            String
  email           String      @unique
  hashed_password String
  role            Role
  sessions        Session[]
  busOwner        BusOwner?   @relation(fields: [busOwnerId], references: [id])
  busOwnerId      String?
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ipAddress  String
  timestamp  DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model Location {
  id               String  @id @default(cuid())
  name             String
  owner            BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  originRoutes     Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String  @unique
  routes   Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId    String?
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal   @db.Decimal(5, 2)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String       @id @default(cuid())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
}

model BookedSeat {
  id          String   @id @default(cuid())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  seatNumber  String
}

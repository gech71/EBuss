
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH MODELS
model User {
  id                      String    @id
  name                    String
  email                   String    @unique
  hashed_password         String?
  role                    Role      @default(USER)
  passwordChangeRequired  Boolean   @default(false)
  busOwnerId              String?
  busOwner                BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  auditLogs               AuditLog[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// APP-SPECIFIC MODELS
model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  bankAccountNumber String            @unique
  buses             Bus[]
  admins            User[]            @relation("OwnerAdmins")
  commissionTiers   CommissionTier[]
  locations         Location[]
  discounts         Discount[]
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String   @id @default(cuid())
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber  String
  type        SeatType
  // Status is now managed on a per-trip basis in TripSeat
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model TripSeat {
  id         String         @id @default(cuid())
  routeId    String
  route      Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  seatNumber String
  status     TripSeatStatus
  bookingId  String?
  booking    Booking?        @relation("TripSeatToBooking", fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([routeId, seatNumber])
}

enum TripSeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}


model Location {
  id             String  @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin   Route[] @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  tripSeats     TripSeat[]

  ticketType              TicketType
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal? @db.Decimal(10, 2)
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

enum DiscountValueType {
    PERCENTAGE
    FIXED
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal       @db.Decimal(10, 2)
  routeId        String
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  expiresAt      DateTime?
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  payments       Payment[]
  roundTripId    String?       @db.Uuid
  tripSeats      TripSeat[]    @relation("TripSeatToBooking")

  @@index([roundTripId])
}

model BookedSeat {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String
}

enum BookingStatus {
  PENDING
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
}

model Discount {
    id String @id @default(cuid())
    name String
    ownerId String
    owner BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    type DiscountType
    startDate DateTime
    endDate DateTime
    percentage Decimal? @db.Decimal(5, 2)
    tiers DiscountTier[]
    routes Route[]
}

enum DiscountType {
    TICKET_COUNT_BASED
    DATE_BASED
}

model DiscountTier {
    id String @id @default(cuid())
    minTickets Int
    maxTickets Int
    percentage Decimal @db.Decimal(5, 2)
    discountId String
    discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Payment {
    id String @id @default(cuid())
    bookingId String
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    amount Decimal @db.Decimal(10, 2)
    status PaymentStatus @default(PENDING)
    transactionId String @unique
    referenceNumber String?
    paymentToken String?
    createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  userRole    Role?
  actionType  String
  description String   @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

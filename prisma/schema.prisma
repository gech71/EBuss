
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  admins          User[]
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation(fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  layout   SeatLayout  @relation(fields: [layoutId], references: [id])
  layoutId String      @unique
  routes   Route[]

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId   String

  @@unique([layoutId, seatNumber])
}

model Route {
  id            String     @id @default(cuid())
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus        @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id])
  discountId    String?

  @@index([busId])
  @@index([discountId])
  @@index([originId])
  @@index([destinationId])
}

model Location {
  id                String  @id @default(cuid())
  name              String
  owner             BusOwner @relation(fields: [ownerId], references: [id])
  ownerId           String
  originRoutes      Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")

  @@unique([ownerId, name])
}

model Booking {
  id             String       @id @default(cuid())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         BookingStatus  @default(VALID)

  @@index([routeId])
}

model BookedSeat {
  id         String   @id @default(cuid())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  seatNumber String

  @@unique([bookingId, seatNumber])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  VALID
  CANCELLED
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  sessions        Session[]
  busOwner        BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  owner       BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  buses             Bus[]
  admins            User[]            @relation("BusOwnerAdmins")
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  layoutId  String      @unique
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layout    SeatLayout  @relation(fields: [layoutId], references: [id])
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id          String      @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layoutId    String
  layout      SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  discountId    String?
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]

  @@index([originId])
  @@index([destinationId])
}

model Booking {
  id              String      @id @default(cuid())
  passengerName   String
  passengerEmail  String
  totalPrice      Float
  bookingTime     DateTime    @default(now())
  routeId         String
  status          BookingStatus
  route           Route       @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
}

model BookedSeat {
    id          String  @id @default(cuid())
    bookingId   String
    seatNumber  String
    booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    @@unique([bookingId, seatNumber])
}

model Discount {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id          String    @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Float
  discountId  String
  discount    Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model CommissionTier {
  id        String          @id @default(cuid())
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Float
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}


enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
}

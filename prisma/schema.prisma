
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  LOCKED // Temporarily held for a pending booking
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  TICKET_COUNT_BASED
  DATE_BASED
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

model User {
  id                      String      @id @unique
  email                   String      @unique
  name                    String
  hashed_password         String?
  role                    Role        @default(USER)
  busOwnerId              String?
  busOwner                BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id], onDelete: SetNull)
  sessions                Session[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  passwordChangeRequired  Boolean     @default(false)
  auditLogs               AuditLog[]
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                String           @id @unique
  name              String           @unique
  bankAccountNumber String           @unique
  admins            User[]           @relation("BusOwnerAdmins")
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  owner      BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales   Int
  maxSales   Int
  type       CommissionType @default(PERCENTAGE)
  value      Decimal        @db.Decimal(10, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layoutId String     @unique
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes   Route[]
  busRoutes BusRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Location {
  id              String     @id @default(cuid())
  name            String
  ownerId         String
  owner           BusOwner   @relation(fields: [ownerId], references: [id])
  routesOrigin    Route[]    @relation("Origin")
  routesDestination Route[]  @relation("Destination")
  busRoutesOrigin   BusRoute[] @relation("BusOrigin")
  busRoutesDestination BusRoute[] @relation("BusDestination")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([name, ownerId])
}


model Route {
  id              String    @id @default(cuid())
  originId        String
  destinationId   String
  departureTime   DateTime
  arrivalTime     DateTime
  price           Decimal   @db.Decimal(10, 2)
  busId           String
  discountId      String?
  origin          Location  @relation("Origin", fields: [originId], references: [id], onDelete: Cascade)
  destination     Location  @relation("Destination", fields: [destinationId], references: [id], onDelete: Cascade)
  bus             Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  discount        Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  ticketType              TicketType        @default(ONE_WAY)
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal?          @db.Decimal(10, 2)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BusRoute {
  id              String   @id @default(cuid())
  busId           String
  originId        String
  destinationId   String
  
  bus             Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin          Location @relation("BusOrigin", fields: [originId], references: [id], onDelete: Cascade)
  destination     Location @relation("BusDestination", fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([busId, originId, destinationId])
}


model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bookedSeats    BookedSeat[]
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  expiresAt      DateTime?
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookedSeat {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  transactionId   String        @unique // From our system
  referenceNumber String?       // From payment provider after confirmation
  paymentToken    String?       // Token received from payment provider to initiate payment
  status          PaymentStatus @default(PENDING)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Discount {
  id         String        @id @default(cuid())
  name       String
  type       DiscountType
  percentage Decimal?      @db.Decimal(5, 2) // For DATE_BASED
  startDate  DateTime
  endDate    DateTime
  ownerId    String
  owner      BusOwner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tiers      DiscountTier[]
  routes     Route[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  userRole    Role?
  actionType  String
  description String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
    id        String   @id @default(cuid())
    ipAddress String
    timestamp DateTime @default(now())
}

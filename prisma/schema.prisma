
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ENUMS
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  BLOCKED
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// MODELS

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String
  role            Role        @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]           @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  discounts       Discount[]
}

model Location {
  id             String  @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin   Route[] @relation("OriginRoutes")
  routesDest     Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId String      @unique
  layout   SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes   Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?

  origin      Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus         Bus       @relation(fields: [busId], references: [id])
  discount    Discount? @relation(fields: [discountId], references: [id])
  bookings    Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  status         BookingStatus @default(VALID)
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String
}


model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  hashed_password String?
  name          String?
  role          Role    @default(USER)
  busOwnerId    String?
  busOwner      BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions      Session[]
  
  @@map("users")
}

model Session {
	id        String   @id
	userId    String
	expiresAt DateTime
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id      String    @id @default(cuid())
  name    String    @unique
  buses   Bus[]     @relation("OwnerBuses")
  admins  User[]    @relation("OwnerAdmins")
  locations Location[] @relation("OwnerLocations")
  discounts Discount[] @relation("OwnerDiscounts")
  commissionTiers CommissionTier[]
}

model Location {
  id String @id @default(cuid())
  name String
  ownerId String
  owner BusOwner @relation("OwnerLocations", fields: [ownerId], references: [id])
  
  routesOrigin    Route[] @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  ownerId   String
  owner     BusOwner    @relation("OwnerBuses", fields: [ownerId], references: [id])
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String    @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType  @default(SEAT)
  layout      SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal    @db.Money
  busId         String
  discountId    String?

  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus        @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id])
}

model Booking {
  id              String      @id @default(cuid())
  passengerName   String
  passengerEmail  String
  totalPrice      Decimal     @db.Money
  bookingTime     DateTime    @default(now())
  routeId         String
  status          BookingStatus @default(VALID)

  route           Route       @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
}

model BookedSeat {
    id String @id @default(cuid())
    bookingId String
    seatNumber String
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    @@unique([bookingId, seatNumber])
}

enum BookingStatus {
    VALID
    CANCELLED
    COMPLETED
}

model Discount {
  id        String      @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  ownerId   String
  owner     BusOwner    @relation("OwnerDiscounts", fields: [ownerId], references: [id])
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Decimal
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model CommissionTier {
    id String @id @default(cuid())
    minSales Decimal
    maxSales Decimal
    type CommissionType
    value Decimal
    ownerId String
    owner BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
    PERCENTAGE
    FIXED
}

model LoginAttempt {
  id          String @id @default(cuid())
  ipAddress   String
  timestamp   DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// AUTHENTICATION MODELS
// ==============================================================

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  hashed_password String?
  role            Role          @default(CUSTOMER)
  sessions        Session[]
  busOwner        BusOwner?     @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  busOwnerId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// ==============================================================
// CORE BUSINESS MODELS
// ==============================================================

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Location {
  id                String   @id @default(cuid())
  name              String
  owner             BusOwner @relation(fields: [ownerId], references: [id])
  ownerId           String
  routesAsOrigin    Route[]  @relation("OriginRoutes")
  routesAsDestination Route[]  @relation("DestinationRoutes")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([name, ownerId])
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  layout    SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  owner     BusOwner   @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
  seatLayoutId String    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layout     SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal    @db.Decimal(10, 2)
  bus           Bus        @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  discountId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  route          Route         @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  status         BookingStatus @default(VALID)
  paymentStatus  PaymentStatus @default(PENDING)
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([passengerPhone])
}

model BookedSeat {
  id         String  @id @default(cuid())
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  seatNumber String
}

enum BookingStatus {
  VALID
  CANCELLED
}

model Payment {
  id              String        @id @default(cuid())
  booking         Booking       @relation(fields: [bookingId], references: id)
  bookingId       String
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}


// ==============================================================
// DISCOUNTS & COMMISSIONS
// ==============================================================

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model CommissionTier {
  id       String         @id @default(cid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

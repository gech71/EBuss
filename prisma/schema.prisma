
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String?
  role            Role        @default(CUSTOMER)
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
    id        String   @id @default(cuid())
    ipAddress String
    timestamp DateTime @default(now())
}


model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]           @relation("OwnerAdmins")
  discounts       Discount[]
  commissionTiers CommissionTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes  Route[]  @relation("OriginRoutes")
  destRoutes    Route[]  @relation("DestinationRoutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, ownerId])
}


model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  routes    Route[]
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id           String     @id @default(cuid())
  seatNumber   String
  status       SeatStatus @default(AVAILABLE)
  type         SeatType
  seatLayoutId String
  layout       SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount?  @relation(fields: [discountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  paymentStatus  String       @default("PENDING")
  payments       Payment[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  seatNumber String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id         String         @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id])
  tiers      DiscountTier[]
  routes     Route[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  amount         Decimal
  transactionId  String    @unique
  paymentToken   String?
  status         String    @default("PENDING") // PENDING, PAID, FAILED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  hashed_password         String
  role                    Role
  busOwnerId              String?
  busOwner                BusOwner? @relation("admins", fields: [busOwnerId], references: [id])
  passwordChangeRequired  Boolean   @default(false)
  auditLogs               AuditLog[]
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  commissionTiers   CommissionTier[]
  admins            User[]           @relation("admins")
  buses             Bus[]
  discounts         Discount[]
  locations         Location[]
}

model CommissionTier {
  id          String         @id @default(cuid())
  minSales    Float
  maxSales    Float
  type        CommissionType
  value       Decimal
  busOwner    BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  busOwnerId  String
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId   String
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId  String      @unique
  routes    Route[]
}

model SeatLayout {
  id      String  @id @default(cuid())
  rows    Int
  cols    Int
  bus     Bus?
  seats   Seat[]
}

model Seat {
  id          String    @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId    String
}

model Location {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  owner       BusOwner @relation(fields: [ownerId], references: [id])
  routesFrom  Route[]  @relation("OriginRoutes")
  routesTo    Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Route {
  id                      String   @id @default(cuid())
  origin                  Location @relation("OriginRoutes", fields: [originId], references: [id])
  originId                String
  destination             Location @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId           String
  bus                     Bus      @relation(fields: [busId], references: [id])
  busId                   String
  departureTime           DateTime
  arrivalTime             DateTime
  price                   Decimal
  bookings                Booking[]
  ticketType              TicketType        @default(ONE_WAY)
  roundTripDiscountValue  Decimal?
  roundTripDiscountType   DiscountValueType?

  discountId              String?
  discount                Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
}

model Booking {
  id              String      @id @default(cuid())
  route           Route       @relation(fields: [routeId], references: [id])
  routeId         String
  passengerName   String
  passengerPhone  String
  totalPrice      Decimal
  bookingTime     DateTime    @default(now())
  status          BookingStatus
  paymentStatus   PaymentStatus
  bookedSeats     BookedSeat[]
  payments        Payment[]
  expiresAt       DateTime?
}

model BookedSeat {
  id          String  @id @default(cuid())
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  seatNumber  String
}

model Payment {
  id              String        @id @default(cuid())
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId       String
  amount          Decimal
  status          PaymentStatus
  createdAt       DateTime      @default(now())
  transactionId   String?       @unique
  referenceNumber String?
  paymentToken    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  type      DiscountType
  startDate DateTime
  endDate   DateTime
  percentage Decimal?
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  ipAddress   String?
  actionType  String
  description String
  createdAt   DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}


// These are legacy models from the original auth setup and are no longer in use.
// They are kept here to avoid breaking changes if old data exists, but new development
// should use direct session management via JWT in cookies.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  USED
  VALID
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
    TICKET_COUNT_BASED
    DATE_BASED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

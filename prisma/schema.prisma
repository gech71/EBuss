
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("admins", fields: [busOwnerId], references: [id])
  sessions        Session[]
  createdAt       DateTime @default(now())

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String   @id @default(cuid())
  name            String   @unique
  commissionTiers CommissionTier[]
  admins          User[]   @relation("admins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  createdAt       DateTime @default(now())
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  @@index([ownerId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id               String   @id @default(cuid())
  name             String
  ownerId          String
  owner            BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes     Route[]  @relation("OriginRoutes")
  destinationRoutes Route[]  @relation("DestinationRoutes")
  createdAt        DateTime @default(now())

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
  createdAt DateTime    @default(now())

  @@index([ownerId])
}

model SeatLayout {
  id        String   @id @default(cuid())
  rows      Int
  cols      Int
  seats     Seat[]
  bus       Bus?
  createdAt DateTime @default(now())
}

model Seat {
  id          String   @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Cascade)
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([busId])
  @@index([originId])
  @@index([destinationId])
  @@index([discountId])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
  createdAt DateTime       @default(now())

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  passengerName  String
  passengerEmail String
  bookingTime    DateTime     @default(now())
  status         BookingStatus @default(VALID)
  paymentStatus  PaymentStatus @default(UNPAID)
  payments       Payment[]

  @@index([routeId])
}

model BookedSeat {
  id        String  @id @default(cuid())
  seatNumber String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amount         Decimal
  status         PaymentStatus @default(PENDING)
  transactionId  String        @unique
  paymentToken   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  UNPAID
}

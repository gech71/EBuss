
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  name            String
  hashed_password String?
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  sessions        Session[]
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation("OwnerLocations", fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  buses             Bus[]
  admins            User[]            @relation("OwnerAdmins")
  discounts         Discount[]
  locations         Location[]        @relation("OwnerLocations")
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id      String         @id @default(cuid())
  minSales  Int
  maxSales  Int
  type    CommissionType
  value   Decimal
  ownerId String
  owner   BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  routes   Route[]
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layoutId String     @unique
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  passengerName  String
  passengerEmail String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         BookingStatus @default(VALID)
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  admins          User[]           @relation("OwnerAdmins")
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

model Location {
  id          String   @id @default(cuid())
  name        String
  owner       BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  originFor   Route[]  @relation("OriginRoutes")
  destFor     Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner   @relation(fields: [ownerId], references: [id])
  ownerId  String
  routes   Route[]
  layout   SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId String     @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]           @relation("OwnerAdmins")
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  routes   Route[]
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layout     SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId    String?
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         String
  payment        Payment?
}

model BookedSeat {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  seatNumber String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model CommissionTier {
  id       String        @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal       @db.Decimal(10, 2)
  owner    BusOwner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model Payment {
  id             String    @id @default(cuid())
  booking        Booking   @relation(fields: [bookingId], references: [id])
  bookingId      String    @unique
  amount         Decimal   @db.Decimal(10, 2)
  transactionId  String    @unique
  paymentToken   String?
  status         String    // e.g., PENDING, COMPLETED, FAILED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

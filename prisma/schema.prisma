
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  buses             Bus[]
  admins            User[]           @relation("OwnerAdmins")
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, minSales, maxSales])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id            String  @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes  Route[] @relation("OriginRoutes")
  destRoutes    Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId String      @unique
  layout   SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes   Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(cuid())
  passengerName   String
  passengerPhone  String
  passengerEmail  String?
  routeId         String
  route           Route         @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
  totalPrice      Decimal       @db.Decimal(10, 2)
  bookingTime     DateTime      @default(now())
  status          BookingStatus @default(VALID)
  paymentStatus   PaymentStatus @default(PENDING)
  payments        Payment[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String
}

enum BookingStatus {
  VALID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  amount       Decimal  @db.Decimal(10, 2)
  transactionId String  @unique
  paymentToken String?
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

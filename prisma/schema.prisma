datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation(fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  routes   Route[]
  layout   SeatLayout?
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus    @relation(fields: [busId], references: [id])
  busId String @unique
  seats Seat[]
}

model Seat {
  id           String     @id @default(cuid())
  seatNumber   String
  status       SeatStatus
  type         SeatType
  layout       SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId     String
}

model Route {
  id            String    @id @default(cuid())
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id          String  @id @default(cuid())
  booking     Booking @relation(fields: [bookingId], references: [id])
  bookingId   String
  seatNumber  String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discount   Discount @relation(fields: [discountId], references: [id])
  discountId String
}

model CommissionTier {
  id      String          @id @default(cuid())
  minSales Float
  maxSales Float
  type    CommissionType
  value   Float
  owner   BusOwner        @relation(fields: [ownerId], references: [id])
  ownerId String
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  FIXED
  PERCENTAGE
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String            @id @default(cuid())
  name            String            @unique
  admins          User[]            @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id])
  layout   SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId String     @unique
  routes   Route[]

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  discountId    String?

  origin      Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus         Bus       @relation(fields: [busId], references: [id])
  bookings    Booking[]
  discount    Discount? @relation(fields: [discountId], references: [id])

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}


model Discount {
    id        String          @id @default(cuid())
    name      String
    startDate DateTime
    endDate   DateTime
    ownerId   String
    owner     BusOwner        @relation(fields: [ownerId], references: [id])
    tiers     DiscountTier[]
    routes    Route[]

    @@index([ownerId])
}

model DiscountTier {
    id         String   @id @default(cuid())
    minTickets Int
    maxTickets Int
    percentage Float
    discountId String
    discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

    @@index([discountId])
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}


enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
    PERCENTAGE
    FIXED
}

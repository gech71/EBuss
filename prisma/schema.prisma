
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  hashed_password String
  role            Role
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("BusOwnerAdmins")
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Location {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin  Route[]  @relation("OriginRoutes")
  routesDest    Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout @relation(fields: [seatLayoutId], references: [id])
  routes   Route[]
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id])
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId   String
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  bookings      Booking[]
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Decimal        @db.Decimal(10, 2)
  maxSales Decimal        @db.Decimal(10, 2)
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

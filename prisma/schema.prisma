
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String   @id @default(cuid())
  name            String   @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]   @relation("OwnerAdmins")
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String   @unique
}

model SeatLayout {
  id      String   @id @default(cuid())
  rows    Int
  cols    Int
  seats   Seat[]
  bus     Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id])

  @@unique([layoutId, seatNumber])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  origin        Location  @relation("RouteOrigins", fields: [originId], references: [id])
  destination   Location  @relation("RouteDestinations", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
}

model Location {
  id                String  @id @default(cuid())
  name              String
  ownerId           String
  owner             BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin      Route[]  @relation("RouteOrigins")
  routesDestination Route[]  @relation("RouteDestinations")
  
  @@unique([ownerId, name])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  status         String       @default("VALID")
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Float
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]

  @@map("bus_owners")
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String

  @@map("commission_tiers")
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@map("locations")
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner   @relation(fields: [ownerId], references: [id])
  layoutId  String     @unique
  layout    SeatLayout @relation(fields: [layoutId], references: [id])
  routes    Route[]

  @@map("buses")
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]

  @@map("seat_layouts")
}

model Seat {
  id         String     @id @default.cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String

  @@map("seats")
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])

  @@map("routes")
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]

  @@map("discounts")
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String

  @@map("discount_tiers")
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Decimal
  status         String       @default("VALID")
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookingTime    DateTime     @default(now())
  bookedSeats    BookedSeat[]

  @@map("bookings")
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String

  @@map("booked_seats")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@map("login_attempts")
}


enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

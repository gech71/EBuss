// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// Users & Authentication
// ========================================

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role        @default(USER)
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner?   @relation(fields: [busOwnerId], references: [id], name: "OwnerAdmins")
  createdAt       DateTime    @default(now())

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  
  @@index([userId])
}

// Rate limiting for login attempts
model LoginAttempt {
  id         String   @id @default(cuid())
  ipAddress  String
  timestamp  DateTime @default(now())
}

// ========================================
// Core Business Models
// ========================================

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id               String  @id @default(cuid())
  name             String
  originRoutes     Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")
  
  ownerId String
  owner   BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([ownerId, name])
  @@index([ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes    Route[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
  @@index([layoutId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?

  origin      Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus         Bus       @relation(fields: [busId], references: [id])
  bookings    Booking[]
  discount    Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  routeId        String
  totalPrice     Decimal      @db.Decimal(10, 2)
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
  bookingTime    DateTime     @default(now())
  
  route       Route        @relation(fields: [routeId], references: [id])
  bookedSeats BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
  id          String   @id @default(cuid())
  bookingId   String
  seatNumber  String
  
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatNumber])
  @@index([bookingId])
}

// ========================================
// Discounts & Commissions
// ========================================

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tiers     DiscountTier[]
  routes    Route[]

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

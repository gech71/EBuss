// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String
  commissionTiers CommissionTier[]
  buses           Bus[]
}

model CommissionTier {
  id        String       @id @default(cuid())
  minSales  Int
  maxSales  Int
  type      CommissionType
  value     Float
  owner     BusOwner     @relation(fields: [ownerId], references: [id])
  ownerId   String
}

model Bus {
  id       String  @id @default(cuid())
  name     String
  capacity Int
  layout   Json // Store the Seat[] array as JSON
  owner    BusOwner @relation(fields: [ownerId], references: [id])
  ownerId  String
  routes   Route[]
}

model Route {
  id            String    @id @default(cuid())
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
}

model Booking {
  id             String   @id @default(cuid())
  route          Route    @relation(fields: [routeId], references: [id])
  routeId        String
  seats          Json // Store the Seat[] array for the booking as JSON
  totalPrice     Float
  bookingTime    DateTime @default(now())
  passengerName  String
  passengerEmail String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discount   Discount @relation(fields: [discountId], references: [id])
  discountId String
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  commissionTiers   CommissionTier[]
  buses             Bus[]
  admins            User[]
  locations         Location[]
  discounts         Discount[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CommissionTier {
  id         String         @id @default(cuid())
  owner      BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  busOwnerId String
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  layout    SeatLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId  String?     @unique
  routes    Route[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)

  @@unique([layoutId, seatNumber])
}

model Location {
  id             String   @id @default(cuid())
  owner          BusOwner @relation(fields: [ownerId], references: [id])
  ownerId        String
  name           String
  originRoutes   Route[]  @relation("OriginRoutes")
  destRoutes     Route[]  @relation("DestinationRoutes")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ownerId, name])
}

model Route {
  id                      String              @id @default(cuid())
  origin                  Location            @relation("OriginRoutes", fields: [originId], references: [id])
  originId                String
  destination             Location            @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId           String
  bus                     Bus                 @relation(fields: [busId], references: [id])
  busId                   String
  departureTime           DateTime
  arrivalTime             DateTime
  price                   Decimal             @db.Decimal(10, 2)
  bookings                Booking[]
  discount                Discount?           @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  discountId              String?
  ticketType              TicketType          @default(ONE_WAY)
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal?            @db.Decimal(10, 2)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model Booking {
  id              String         @id @default(cuid())
  route           Route          @relation(fields: [routeId], references: [id])
  routeId         String
  passengerName   String
  passengerPhone  String
  totalPrice      Decimal        @db.Decimal(10, 2)
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  bookedSeats     BookedSeat[]
  bookingTime     DateTime       @default(now())
  expiresAt       DateTime?
  roundTripId     String?        // Link for round trips
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([roundTripId])
}

model BookedSeat {
  id          String  @id @default(cuid())
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  seatNumber  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  type        DiscountType
  startDate   DateTime
  endDate     DateTime
  owner       BusOwner      @relation(fields: [ownerId], references: [id])
  ownerId     String
  tiers       DiscountTier[]
  percentage  Decimal?      @db.Decimal(5, 2) // For DATE_BASED discounts
  routes      Route[]
}

model DiscountTier {
  id          String   @id @default(cuid())
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId  String
  minTickets  Int
  maxTickets  Int
  percentage  Decimal  @db.Decimal(5, 2)
}

// Authentication Models
model User {
  id                      String    @id
  email                   String    @unique
  name                    String
  hashed_password         String?
  role                    Role      @default(USER)
  busOwner                BusOwner? @relation(fields: [busOwnerId], references: [id])
  busOwnerId              String?
  passwordChangeRequired  Boolean   @default(false)
  sessions                Session[]
  auditLogs               AuditLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Payment Models
model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Float
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  transactionId   String        @unique // This is our internal UUID for the transaction
  referenceNumber String? // This is the external reference from the payment provider
  paymentToken    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Logging Models
model AuditLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  userRole     Role?
  actionType   String
  description  String
  ipAddress    String?
  createdAt    DateTime  @default(now())
}

model LoginAttempt {
  id          String      @id @default(cuid())
  ipAddress   String
  timestamp   DateTime    @default(now())
}

model ApiRequestAttempt {
  id          String      @id @default(cuid())
  ipAddress   String
  timestamp   DateTime    @default(now())
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

enum BookingStatus {
  PENDING
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  TICKET_COUNT_BASED
  DATE_BASED
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

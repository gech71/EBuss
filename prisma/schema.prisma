
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role        @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id               String           @id @default(cuid())
  name             String           @unique
  commissionTiers  CommissionTier[]
  buses            Bus[]
  admins           User[]           @relation("BusOwnerAdmins")
  discounts        Discount[]
  locations        Location[]
}

model CommissionTier {
  id        String          @id @default(cuid())
  minSales  Int
  maxSales  Int
  type      CommissionType
  value     Decimal
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  
  @@unique([layoutId, seatNumber])
}

model Location {
  id            String  @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes  Route[] @relation("OriginRoutes")
  destRoutes    Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  discountId    String?

  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus        @relation(fields: [busId], references: [id])
  discount      Discount?  @relation(fields: [discountId], references: [id])
  bookings      Booking[]
}

model Booking {
  id              String      @id @default(cuid())
  passengerName   String
  passengerEmail  String
  totalPrice      Decimal
  bookingTime     DateTime    @default(now())
  status          String      @default("VALID")
  routeId         String
  route           Route       @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
}

model BookedSeat {
  id          String   @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Discount {
  id          String         @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  ownerId     String
  owner       BusOwner       @relation(fields: [ownerId], references: [id])
  tiers       DiscountTier[]
  routes      Route[]
}

model DiscountTier {
  id           String   @id @default(cuid())
  minTickets   Int
  maxTickets   Int
  percentage   Decimal
  discountId   String
  discount     Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

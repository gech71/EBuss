
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin Route[] @relation("OriginRoutes")
  routesDest   Route[] @relation("DestinationRoutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, ownerId])
  @@index([ownerId])
}

model BusOwner {
  id              String   @id @default(cuid())
  name            String   @unique
  buses           Bus[]
  admins          User[]   @relation("OwnerAdmins")
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  routes   Route[]
  seatLayoutId String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([busId])
  @@index([originId])
  @@index([destinationId])
  @@index([discountId])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

enum BookingStatus {
  VALID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Booking {
  id              String        @id @default(cuid())
  passengerName   String
  passengerPhone  String
  passengerEmail  String?
  routeId         String
  route           Route         @relation(fields: [routeId], references: [id])
  totalPrice      Decimal       @db.Decimal(10, 2)
  bookingTime     DateTime      @default(now())
  status          BookingStatus @default(VALID)
  paymentStatus   PaymentStatus @default(PENDING)
  bookedSeats     BookedSeat[]
  payments        Payment[]

  @@index([routeId])
}

model BookedSeat {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String

  @@index([bookingId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([bookingId])
}

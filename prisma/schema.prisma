
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
    id        String   @id @default(cuid())
    ipAddress String
    timestamp DateTime @default(now())
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  locations       Location[]
  discounts       Discount[]
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model CommissionTier {
  id      String         @id @default(cuid())
  ownerId String
  owner   BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales Decimal
  maxSales Decimal
  type    CommissionType
  value   Decimal
}

model Location {
  id          String  @id @default(cuid())
  name        String
  ownerId     String
  owner       BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  seatLayoutId String?  @unique
  layout    SeatLayout? @relation(fields: [seatLayoutId], references: [id], onDelete: SetNull)
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID")
}

model BookedSeat {
    id String @id @default(cuid())
    bookingId String
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    seatNumber String
}

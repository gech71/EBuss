
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id              String  @id @unique
  email           String  @unique
  name            String
  hashed_password String?
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String            @id @unique
  name              String            @unique
  bankAccountNumber String            @unique
  buses             Bus[]
  admins            User[]            @relation("OwnerAdmins")
  discounts         Discount[]
  locations         Location[]
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  minSales   Decimal
  maxSales   Decimal
  type       CommissionType
  value      Decimal
  owner      BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id             String    @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes   Route[]   @relation("OriginRoutes")
  destRoutes     Route[]   @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes    Route[]
  layoutId  String?     @unique
  layout    SeatLayout?
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?   @relation(fields: [id], references: [layoutId])
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  destinationId String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull)
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model Booking {
  id             String        @id @default(cuid())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  passengerName  String
  passengerPhone String
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  bookedSeats    BookedSeat[]
  payments       Payment[]
  expiresAt      DateTime?
}

model BookedSeat {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete Cascade)
  amount          Decimal
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
}

enum BookingStatus {
  PENDING
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

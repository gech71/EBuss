
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  admins          User[]           @relation("BusOwnerAdmins")
}

model CommissionTier {
  id      String         @id @default(cuid())
  minSales  Float
  maxSales  Float
  type    CommissionType
  value   Float
  ownerId String
  owner   BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String   @unique
  routes   Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         String
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

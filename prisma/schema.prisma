
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  name            String
  hashed_password String
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("admins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("admins")
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model Location {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes  Route[]  @relation("origin")
  destRoutes    Route[]  @relation("destination")

  @@unique([name, ownerId])
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner   @relation(fields: [ownerId], references: [id])
  layout    SeatLayout @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String  @unique
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId   String
}

model Route {
  id            String     @id @default(cuid())
  origin        Location   @relation("origin", fields: [originId], references: [id])
  originId      String
  destination   Location   @relation("destination", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  bus           Bus        @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  status         BookingStatus @default(VALID)
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String
  seatNumber String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
  minTickets Int
  maxTickets Int
  percentage Float
}

model CommissionTier {
  id       String         @id @default(cuid())
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  VALID
  CANCELLED
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

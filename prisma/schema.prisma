
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native"]
}

model User {
  id              String    @id
  email           String    @unique
  name            String
  hashed_password String
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation(fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  buses             Bus[]
  admins            User[]
  locations         Location[]
  commissionTiers   CommissionTier[]
  discounts         Discount[]
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  owner      BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Decimal
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  Bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus
  type       SeatType
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Location {
  id                String  @id @default(cuid())
  name              String
  ownerId           String
  owner             BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes      Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Booking {
  id              String       @id @default(cuid())
  passengerName   String
  passengerPhone  String
  routeId         String
  route           Route        @relation(fields: [routeId], references: [id])
  bookedSeats     BookedSeat[]
  totalPrice      Decimal
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  bookingTime     DateTime     @default(now())
  payments        Payment[]
  expiresAt       DateTime?

  @@index([bookingTime])
}

model BookedSeat {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String

  @@unique([bookingId, seatNumber])
}

enum BookingStatus {
  PENDING
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal
  status          PaymentStatus @default(PENDING)
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Discount {
  id          String         @id @default(cuid())
  ownerId     String
  owner       BusOwner       @relation(fields: [ownerId], references: [id])
  name        String
  startDate   DateTime
  endDate     DateTime
  tiers       DiscountTier[]
  routes      Route[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ownerId, name])
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String
  hashed_password          String?
  role                     Role
  busOwnerId               String?
  passwordChangeRequired   Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  passwordSetupToken       String?   @unique
  passwordSetupExpires     DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  sessions                 Session[]
  busOwner                 BusOwner? @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  AuditLog                 AuditLog[]
  failedLoginAttempts      Int       @default(0)
  lockoutUntil             DateTime?
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  admins            User[]
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layout    SeatLayout?
  routes    Route[]
  busRoutes BusRoute[]
}

model SeatLayout {
  id      String @id @default(cuid())
  busId   String @unique
  rows    Int
  cols    Int
  seats   Seat[]
  bus     Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  seatNumber String
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Location {
  id               String   @id @default(cuid())
  name             String
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin     Route[]  @relation("OriginRoutes")
  routesDestination Route[]  @relation("DestinationRoutes")
  busRoutesOrigin  BusRoute[] @relation("BusRouteOrigin")
  busRoutesDestination BusRoute[] @relation("BusRouteDestination")

  @@unique([name, ownerId])
}

model BusRoute {
  id            String   @id @default(cuid())
  busId         String
  originId      String
  destinationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bus           Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin        Location @relation("BusRouteOrigin", fields: [originId], references: [id], onDelete: Cascade)
  destination   Location @relation("BusRouteDestination", fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([busId, originId, destinationId])
}


model Route {
  id            String   @id @default(cuid())
  originId      String
  destinationId String
  busId         String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal  @db.Decimal(10, 2)
  discountId    String?
  ticketType    TicketType @default(ONE_WAY)
  roundTripDiscountType DiscountValueType?
  roundTripDiscountValue Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bus           Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  destination   Location @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Cascade)
  origin        Location @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal       @db.Decimal(10, 2)
  routeId        String
  paymentStatus  PaymentStatus @default(PENDING)
  expiresAt      DateTime?
  route          Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  payments       Payment[]
}

model Ticket {
  id         String       @id @default(cuid())
  bookingId  String
  seatNumber String
  status     TicketStatus @default(PENDING)
  routeId    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  route      Route        @relation(fields: [routeId], references: [id], onDelete: NoAction)
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  paymentToken    String?
  transactionId   String        @unique
  referenceNumber String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}


model Discount {
    id        String @id @default(cuid())
    name      String
    type      DiscountType
    startDate DateTime
    endDate   DateTime
    percentage Decimal? @db.Decimal(5, 2)
    ownerId   String
    owner     BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    tiers     DiscountTier[]
    routes    Route[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model DiscountTier {
    id          String   @id @default(cuid())
    discountId  String
    minTickets  Int
    maxTickets  Int
    percentage  Decimal  @db.Decimal(5, 2)
    discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
}

model CommissionTier {
    id         String   @id @default(cuid())
    busOwnerId String
    minSales   Int
    maxSales   Int
    type       CommissionType
    value      Decimal @db.Decimal(10, 2)
    owner      BusOwner @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  actionType  String
  description String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum TicketStatus {
  PENDING
  VALID
  USED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
    DATE_BASED
    TICKET_COUNT_BASED
}

enum CommissionType {
    PERCENTAGE
    FIXED
}

enum TicketType {
    ONE_WAY
    ROUND_TRIP
}

enum DiscountValueType {
    PERCENTAGE
    FIXED
}

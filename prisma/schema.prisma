
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

// ENUMS
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  BLOCKED
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

// AUTHENTICATION
model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role        @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// CORE MODELS
model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  
  routesOrigin    Route[] @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  commissionTiers   CommissionTier[]
  buses             Bus[]
  admins            User[]            @relation("OwnerAdmins")
  locations         Location[]
  discounts         Discount[]
}

model CommissionTier {
  id        String          @id @default(cuid())
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layoutId String      @unique
  layout   SeatLayout  @relation(fields: [layoutId], references: [id])
  routes   Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id          String     @id @default(cuid())
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Restrict)
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Restrict)
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  bookings      Booking[]
}

model Discount {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
}

model BookedSeat {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String
}

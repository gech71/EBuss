
generator client {
  provider = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  hashed_password String
  role            Role          @default(USER)
  busOwnerId      String?
  busOwner        BusOwner?     @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]            @relation("OwnerBuses")
  locations       Location[]       @relation("OwnerLocations")
  admins          User[]           @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  discounts       Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  ownerId  String
  minSales Float
  maxSales Float
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  ownerId   String
  owner     BusOwner    @relation("OwnerBuses", fields: [ownerId], references: [id])
  routes    Route[]
  
  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  
  origin        Location  @relation("RouteOrigins", fields: [originId], references: [id])
  destination   Location  @relation("RouteDestinations", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]

  @@index([busId])
  @@index([originId])
  @@index([destinationId])
  @@index([discountId])
}

model Location {
  id               String  @id @default(cuid())
  name             String
  ownerId          String
  owner            BusOwner @relation("OwnerLocations", fields: [ownerId], references: [id])
  routesOrigin     Route[]  @relation("RouteOrigins")
  routesDestination Route[] @relation("RouteDestinations")

  @@unique([name, ownerId])
  @@index([ownerId])
}


model Discount {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  
  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  passengerName  String
  passengerEmail String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         BookingStatus @default(VALID)

  route       Route        @relation(fields: [routeId], references: [id])
  bookedSeats BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

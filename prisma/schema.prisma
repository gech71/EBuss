// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String
  role            Role
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id               String           @id @default(cuid())
  name             String           @unique
  buses            Bus[]
  admins           User[]           @relation("OwnerAdmins")
  discounts        Discount[]
  commissionTiers  CommissionTier[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}


model Bus {
  id      String     @id @default(cuid())
  name    String
  capacity Int
  routes  Route[]
  layout  SeatLayout @relation(fields: [seatLayoutId], references: [id])
  ownerId String
  owner   BusOwner   @relation(fields: [ownerId], references: [id])
  seatLayoutId String @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id           String     @id @default(cuid())
  seatNumber   String
  status       SeatStatus
  type         SeatType
  seatLayoutId String
  layout       SeatLayout @relation(fields: [seatLayoutId], references: [id])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  BLOCKED
}

model Location {
  id                String  @id @default(cuid())
  name              String  @unique
  originRoutes      Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")
}

model Route {
  id              String    @id @default(cuid())
  departureTime   DateTime
  arrivalTime     DateTime
  price           Float
  busId           String
  bus             Bus       @relation(fields: [busId], references: [id])
  originId        String
  origin          Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId   String
  destination     Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bookings        Booking[]
  discountId      String?
  discount        Discount? @relation(fields: [discountId], references: [id])
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Float
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Float
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id])
}

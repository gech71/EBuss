
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                String            @id @default(cuid())
  name              String            @unique
  bankAccountNumber String            @unique
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
  admins            User[]            @relation("OwnerAdmins")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CommissionTier {
  id         String          @id @default(cuid())
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Float
  busOwnerId String
  busOwner   BusOwner        @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id        String   @id @default(cuid())
  rows      Int
  cols      Int
  seats     Seat[]
  bus       Bus?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([layoutId, seatNumber])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Location {
  id                 String   @id @default(cuid())
  name               String
  ownerId            String
  owner              BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin       Route[]  @relation("OriginRoutes")
  routesDestination  Route[]  @relation("DestinationRoutes")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([ownerId, name])
}

model Route {
  id            String      @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal     @db.Decimal(10, 2)
  busId         String
  discountId    String?
  origin        Location    @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location    @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus         @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discount      Discount?   @relation(fields: [discountId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  routes    Route[]
  tiers     DiscountTier[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  totalPrice     Decimal       @db.Decimal(10, 2)
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  bookingTime    DateTime      @default(now())
  status         BookingStatus
  paymentStatus  PaymentStatus
  payments       Payment[]
}

model BookedSeat {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  VALID
  CANCELLED
  USED
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

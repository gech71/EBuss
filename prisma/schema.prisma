// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @unique
  email     String  @unique
  name      String
  role      Role    @default(USER)
  busOwnerId String?
  busOwner  BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  hashed_password String?
  passwordChangeRequired Boolean @default(false)
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                String           @id @unique
  name              String           @unique
  bankAccountNumber String           @unique
  buses             Bus[]
  admins            User[]           @relation("OwnerAdmins")
  commissionTiers   CommissionTier[]
  discounts         Discount[]
  locations         Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  minSales   Decimal
  maxSales   Decimal
  type       CommissionType
  value      Decimal
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)

  @@index([busOwnerId])
}

model Location {
  id             String  @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes   Route[] @relation("OriginRoutes")
  destRoutes     Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes   Route[]
  layoutId String?     @unique
  layout   SeatLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id         String  @id @default(cuid())
  originId   String
  origin     Location @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Cascade)
  destinationId String
  destination Location @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Cascade)
  busId      String
  bus        Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  departureTime DateTime
  arrivalTime   DateTime
  price      Decimal
  bookings   Booking[]
  
  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  ticketType TicketType @default(ONE_WAY)
  roundTripDiscountType DiscountValueType?
  roundTripDiscountValue Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([busId])
  @@index([originId])
  @@index([destinationId])
  @@index([discountId])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  status         BookingStatus @default(PENDING)
  bookingTime    DateTime      @default(now())
  expiresAt      DateTime?
  paymentStatus  PaymentStatus @default(PENDING)
  payments       Payment[]

  @@index([routeId])
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String

  @@index([bookingId])
}

model Payment {
    id String @id @default(cuid())
    bookingId String
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    amount Decimal
    status PaymentStatus @default(PENDING)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    transactionId String @unique
    referenceNumber String?
    paymentToken String?
    
    @@index([bookingId])
}


model Discount {
  id         String         @id @default(cuid())
  name       String
  type       DiscountType
  percentage Decimal?
  startDate  DateTime
  endDate    DateTime
  tiers      DiscountTier[]
  routes     Route[]
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model DiscountTier {
  id          String   @id @default(cuid())
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets  Int
  maxTickets  Int
  percentage  Decimal

  @@index([discountId])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        Int      @id @default(autoincrement())
  ipAddress String
  timestamp DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      String?
  userName    String?
  userRole    Role?
  ipAddress   String?
  actionType  String
  description String
  createdAt   DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
}

enum DiscountType {
  TICKET_COUNT_BASED
  DATE_BASED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  LOCKED // Temporarily held
}

enum BookingStatus {
  PENDING
  VALID
  USED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  DATE_BASED
  TICKET_COUNT_BASED
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

// --------------------------------------
// AUTH & USERS
// --------------------------------------

model User {
  id    String @id
  email String @unique
  name  String

  role               Role     @default(USER)
  hashed_password    String
  passwordChangeRequired Boolean  @default(false)
  busOwnerId         String?
  busOwner           BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  
  auditLogs          AuditLog[]
  sessions           Session[]

  @@index([busOwnerId])
}

model Session {
	id        String   @id
	expiresAt DateTime
	userId    String
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// CORE MODELS
// --------------------------------------

model BusOwner {
  id                String  @id
  name              String  @unique
  bankAccountNumber String  @unique

  admins            User[]  @relation("OwnerAdmins")
  buses             Bus[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model Bus {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  
  ownerId   String
  owner     BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  layoutId  String   @unique
  layout    SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  
  routes    Route[]
  busRoutes BusRoute[]

  @@index([ownerId])
}

model BusRoute {
  id String @id @default(cuid())
  busId String
  originId String
  destinationId String

  bus         Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin      Location  @relation("BusRouteOrigins", fields: [originId], references: [id], onDelete: Cascade)
  destination Location  @relation("BusRouteDestinations", fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([busId, originId, destinationId])
  @@index([busId])
  @@index([originId])
  @@index([destinationId])
}


model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String   @id @default(cuid())
  seatNumber  String
  type        SeatType
  
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Location {
  id   String @id @default(cuid())
  name String
  
  ownerId String
  owner   BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  routesOrigin      Route[] @relation("RouteOrigins")
  routesDestination Route[] @relation("RouteDestinations")
  
  busRoutesOrigin      BusRoute[] @relation("BusRouteOrigins")
  busRoutesDestination BusRoute[] @relation("BusRouteDestinations")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Route {
  id             String    @id @default(cuid())
  departureTime  DateTime
  arrivalTime    DateTime
  price          Decimal   @db.Decimal(10, 2)
  
  originId       String
  origin         Location  @relation("RouteOrigins", fields: [originId], references: [id], onDelete: Restrict)
  
  destinationId  String
  destination    Location  @relation("RouteDestinations", fields: [destinationId], references: [id], onDelete: Restrict)
  
  busId          String
  bus            Bus       @relation(fields: [busId], references: [id], onDelete: Restrict)
  
  discountId     String?
  discount       Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  bookings       Booking[]
  
  ticketType             TicketType        @default(ONE_WAY)
  roundTripDiscountType  DiscountValueType?
  roundTripDiscountValue Decimal?          @db.Decimal(10, 2)

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String    @id @default(cuid())
  bookingTime    DateTime  @default(now())
  passengerName  String
  passengerPhone String
  totalPrice     Decimal   @db.Decimal(10, 2)
  status         BookingStatus
  paymentStatus  PaymentStatus
  expiresAt      DateTime

  routeId        String
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Restrict)

  bookedSeats    BookedSeat[]
  payments       Payment[]

  @@index([routeId])
  @@index([passengerPhone])
}

model BookedSeat {
  id           String  @id @default(cuid())
  seatNumber   String
  
  bookingId    String
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
    id              String @id @default(cuid())
    bookingId       String
    booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    amount          Decimal @db.Decimal(10, 2)
    status          PaymentStatus @default(PENDING)
    createdAt       DateTime @default(now())
    transactionId   String @unique // From our system
    referenceNumber String? // From payment provider
    paymentToken    String?

    @@index([bookingId])
}


// --------------------------------------
// TIERS & DISCOUNTS
// --------------------------------------

model CommissionTier {
  id          String   @id @default(cuid())
  busOwnerId  String
  busOwner    BusOwner @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales    Float
  maxSales    Float
  type        CommissionType
  value       Decimal  @db.Decimal(10, 2)
  
  @@index([busOwnerId])
}

model Discount {
  id         String     @id @default(cuid())
  name       String
  type       DiscountType
  startDate  DateTime
  endDate    DateTime
  percentage Decimal?   @db.Decimal(5, 2)
  
  ownerId    String
  owner      BusOwner   @relation(fields: [ownerId], references[id], onDelete: Cascade)
  
  tiers      DiscountTier[]
  routes     Route[]

  @@index([ownerId])
}

model DiscountTier {
    id         String   @id @default(cuid())
    discountId String
    discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
    minTickets Int
    maxTickets Int
    percentage Decimal  @db.Decimal(5, 2)

    @@index([discountId])
}

// --------------------------------------
// LOGGING & UTILS
// --------------------------------------

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  actionType  String
  description String
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("BusOwnerAdmins")
  commissionTiers CommissionTier[]
  discounts       Discount[]
  locations       Location[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId  String
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id                String   @id @default(cuid())
  name              String
  ownerId           String?
  owner             BusOwner? @relation(fields: [ownerId], references: [id])
  routesOrigin      Route[]  @relation("OriginRoutes")
  routesDestination Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  routes    Route[]
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String   @unique
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId   String
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String   @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layout      SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  BLOCKED
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  totalPrice     Decimal
  status         BookingStatus
  paymentStatus  PaymentStatus @default(PENDING)
  bookingTime    DateTime      @default(now())
  route          Route         @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  payments       Payment[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

enum BookingStatus {
  VALID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  amount         Decimal
  transactionId  String    @unique
  paymentToken   String?
  status         PaymentStatus
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}


// MODELS

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role        @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner?   @relation("admins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("admins")
  commissionTiers CommissionTier[]
  locations       Location[]
  discounts       Discount[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales Decimal
  maxSales Decimal
  type     CommissionType
  value    Decimal
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes   Route[]
  layoutId String      @unique
  layout   SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
}

model Location {
  id                 String  @id @default(cuid())
  name               String
  ownerId            String
  owner              BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin       Route[] @relation("Origin")
  routesDestination  Route[] @relation("Destination")
  
  @@unique([name, ownerId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  origin        Location  @relation("Origin", fields: [originId], references: [id])
  destination   Location  @relation("Destination", fields: [destinationId], references: [id])
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

   @@index([originId, destinationId, departureTime])
}


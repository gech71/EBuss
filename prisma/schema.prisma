// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id
  email                   String    @unique
  name                    String
  hashed_password         String?
  role                    Role
  busOwnerId              String?
  busOwner                BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions                Session[]
  auditLogs               AuditLog[]
  passwordChangeRequired  Boolean   @default(false)

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model BusOwner {
  id                  String           @id
  name                String           @unique
  bankAccountNumber   String           @unique
  buses               Bus[]            @relation("OwnerBuses")
  admins              User[]           @relation("OwnerAdmins")
  locations           Location[]       @relation("OwnerLocations")
  discounts           Discount[]       @relation("OwnerDiscounts")
  commissionTiers     CommissionTier[]
}

model Location {
  id              String      @id @default(cuid())
  name            String
  ownerId         String
  owner           BusOwner    @relation("OwnerLocations", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  originRoutes    Route[]     @relation("OriginRoutes")
  destinationRoutes Route[]   @relation("DestinationRoutes")
  originBusRoutes BusRoute[]  @relation("BusRouteOrigins")
  destinationBusRoutes BusRoute[] @relation("BusRouteDestinations")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id       String    @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner  @relation("OwnerBuses", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  layout   SeatLayout?
  routes   Route[]
  busRoute BusRoute?

  @@index([ownerId])
}

model SeatLayout {
  id      String @id @default(cuid())
  rows    Int
  cols    Int
  busId   String @unique
  bus     Bus    @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seats   Seat[]
}

model Seat {
  id          String   @id @default(cuid())
  seatNumber  String
  type        SeatType
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([layoutId, seatNumber])
  @@index([layoutId])
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model BusRoute {
  id            String    @id @default(cuid())
  busId         String    @unique
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  originId      String
  origin        Location @relation("BusRouteOrigins", fields: [originId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  destinationId String
  destination   Location @relation("BusRouteDestinations", fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  @@index([busId])
  @@index([originId])
  @@index([destinationId])
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinationId String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal    @db.Decimal(10, 2)
  tickets       Ticket[]
  bookings      Booking[]
  
  discountId             String?
  discount               Discount?          @relation(fields: [discountId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  ticketType             TicketType         @default(ONE_WAY)
  roundTripDiscountType  DiscountValueType?
  roundTripDiscountValue Decimal?           @db.Decimal(10, 2)

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  bookingTime    DateTime      @default(now())
  totalPrice     Decimal       @db.Decimal(10, 2)
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentStatus  PaymentStatus
  tickets        Ticket[]
  payments       Payment[]
  expiresAt      DateTime?

  @@index([passengerPhone])
  @@index([routeId])
}

model Ticket {
  id          String       @id @default(cuid())
  seatNumber  String
  status      TicketStatus
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  routeId     String
  route       Route        @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId])
  @@index([routeId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?
  createdAt       DateTime      @default(now())

  @@index([bookingId])
}

model Discount {
  id          String         @id @default(cuid())
  name        String
  type        DiscountType
  startDate   DateTime
  endDate     DateTime
  percentage  Decimal?       @db.Decimal(5, 2) // For date-based
  ownerId     String
  owner       BusOwner       @relation("OwnerDiscounts", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tiers       DiscountTier[]
  routes      Route[]

  @@index([ownerId])
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Decimal  @db.Decimal(5, 2)
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([discountId])
}

model CommissionTier {
  id          String         @id @default(cuid())
  minSales    Float
  maxSales    Float
  type        CommissionType
  value       Float
  busOwnerId  String
  busOwner    BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([busOwnerId])
}

enum TicketStatus {
  PENDING
  VALID
  USED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
    TICKET_COUNT_BASED
    DATE_BASED
}

enum TicketType {
  ONE_WAY
  ROUND_TRIP
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// Security & Logging Models
model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  userName    String?
  userRole    Role?
  actionType  String
  description String
  details     Json?
  createdAt   DateTime  @default(now())
  ipAddress   String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  @@index([userId])
  @@index([actionType])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())

  @@index([ipAddress, timestamp])
}

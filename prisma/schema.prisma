// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  BLOCKED
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

// MODELS

// Authentication
model User {
  id              String       @id
  name            String
  email           String       @unique
  hashed_password String
  role            Role
  session         Session[]
  busOwner        BusOwner?    @relation(fields: [busOwnerId], references: [id], name: "BusOwnerAdmins")
  busOwnerId      String?
  loginAttempts   LoginAttempt[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

// Core Models
model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("BusOwnerAdmins")
  buses           Bus[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
  locations       Location[]
}

model Location {
  id                String  @id @default(cuid())
  name              String
  originRoutes      Route[] @relation("OriginRoutes")
  destinationRoutes Route[] @relation("DestinationRoutes")
  owner             BusOwner @relation(fields: [ownerId], references: [id])
  ownerId           String

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId   String
  layout    SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  seatLayoutId String   @unique
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId   String
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
  bookings      Booking[]
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal @db.Decimal(5, 2)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerEmail String
  route          Route         @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  status         BookingStatus @default(VALID)
}

model BookedSeat {
  id         String  @id @default(cuid())
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  seatNumber String
}

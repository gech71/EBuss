// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Authentication
model User {
  id              String  @id @unique
  name            String
  email           String  @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

// Security & Auditing
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}


// Core Business Models
model BusOwner {
  id                 String           @id @default(cuid())
  name               String           @unique
  bankAccountNumber  String           @unique
  buses              Bus[]
  routes             Route[]          @relation("OwnerRoutes") // Routes created by this owner's buses
  admins             User[]           @relation("OwnerAdmins")
  locations          Location[]
  discounts          Discount[]
  commissionTiers    CommissionTier[]
}

model Location {
  id               String   @id @default(cuid())
  name             String
  ownerId          String
  owner            BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes     Route[]  @relation("OriginRoutes")
  destinationRoutes Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId]) // An owner can't have two locations with the same name
  @@index([ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  routes    Route[]
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, seatNumber])
  @@index([layoutId])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  EMPTY
}

model Route {
  id            String    @id @default(cdfl())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bookings      Booking[]
  busOwnerId    String? // Denormalized for easier querying
  busOwner      BusOwner? @relation("OwnerRoutes", fields: [busOwnerId], references: [id])
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([departureTime])
  @@index([discountId])
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  status         BookingStatus @default(PENDING)
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  payments       Payment[]
  paymentStatus  PaymentStatus @default(PENDING)

  @@index([passengerPhone])
  @@index([routeId])
  @@index([bookingTime])
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum BookingStatus {
  PENDING
  VALID
  CANCELLED
  USED
  EXPIRED
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactionId   String        @unique // Our internal reference
  paymentToken    String?       // Token from payment gateway to initiate payment
  referenceNumber String?       // Reference from payment gateway after completion

  @@index([bookingId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Commission and Discount Models
model CommissionTier {
  id         String         @id @default(cuid())
  busOwnerId String
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
  minSales   Decimal        @db.Decimal(12, 2)
  maxSales   Decimal        @db.Decimal(12, 2)
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)

  @@index([busOwnerId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)

  @@index([discountId])
}


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// --- Models ---
model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("OwnerAdmins")
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model CommissionTier {
  id        String         @id @default(cuid())
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Float
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, minSales, maxSales])
}


model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")
  
  @@unique([ownerId, name])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id])
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  discountId    String?
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus        @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  routeId        String
  passengerName  String
  passengerEmail String
  totalPrice     Float
  bookingTime    DateTime      @default(now())
  status         BookingStatus @default(VALID)
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  seatNumber String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

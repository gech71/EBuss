
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models
model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  hashed_password String
  role            Role       @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner?  @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  commissionTiers CommissionTier[]
  admins          User[]           @relation("BusOwnerAdmins")
  locations       Location[]
  discounts       Discount[]
}

model Location {
  id           String  @id @default(cuid())
  name         String
  ownerId      String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  routes   Route[]
  seatLayoutId String   @unique

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?

  origin      Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus         Bus       @relation(fields: [busId], references: [id])
  discount    Discount? @relation(fields: [discountId], references: [id])
  bookings    Booking[]

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  passengerName  String
  passengerEmail String
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         BookingStatus @default(VALID)
  
  route       Route        @relation(fields: [routeId], references: [id])
  bookedSeats BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
  id String @id @default(cuid())
  bookingId String
  seatNumber String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}


model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

model CommissionTier {
  id       String          @id @default(cuid())
  ownerId  String
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal         @db.Decimal(10, 2)
  owner    BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ipAddress  String
  timestamp  DateTime @default(now())

  @@index([ipAddress, timestamp])
}

// Enums
enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum BookingStatus {
  VALID
  CANCELLED
}

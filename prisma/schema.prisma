
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String
  role            Role    @default(USER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@index([busOwnerId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model Location {
  id             String   @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin   Route[]  @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
  @@index([ownerId])
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("BusOwnerAdmins")
  buses           Bus[]
  commissionTiers CommissionTier[]
  locations       Location[]
  discounts       Discount[]
}

model Bus {
  id       String     @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout @relation(fields: [seatLayoutId], references: [id])
  ownerId  String
  owner    BusOwner   @relation(fields: [ownerId], references: [id])
  routes   Route[]
  seatLayoutId String @unique

  @@index([ownerId])
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  discountId    String?
  
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  bus           Bus        @relation(fields: [busId], references: [id])
  discount      Discount?  @relation(fields: [discountId], references: [id])
  bookings      Booking[]

  @@index([originId])
  @@index([destinationId])
  @@index([busId])
  @@index([discountId])
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  status         BookingStatus @default(VALID)
  routeId        String
  bookingTime    DateTime     @default(now())
  
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]

  @@index([routeId])
}

model BookedSeat {
    id          String @id @default(cuid())
    bookingId   String
    seatNumber  String
    booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    @@index([bookingId])
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]

  @@index([ownerId])
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Float
  maxSales Float
  type     CommissionType
  value    Float
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  VALID
  CANCELLED
  USED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

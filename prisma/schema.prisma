// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  hashed_password String?
  role            Role    @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  buses           Bus[]
  locations       Location[]
  admins          User[]           @relation("OwnerAdmins")
  discounts       Discount[]
}

model CommissionTier {
  id      String         @id @default(cuid())
  owner   BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  minSales Decimal
  maxSales Decimal
  type    CommissionType
  value   Decimal

  @@unique([ownerId, minSales, maxSales])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id        String     @id @default(cuid())
  name      String
  capacity  Int
  owner     BusOwner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  layout    SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String @unique
  routes    Route[]
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId    String

   @@unique([layoutId, seatNumber])
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}


model Location {
  id            String  @id @default(cuid())
  name          String
  ownerId       String
  owner         BusOwner @relation(fields: [ownerId], references: [id])
  originRoutes  Route[] @relation("OriginRoutes")
  destRoutes    Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}


model Route {
  id            String     @id @default(cuid())
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus        @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount?  @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
  minTickets Int
  maxTickets Int
  percentage Decimal
}

model Booking {
  id             String       @id @default(cuid())
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID") // e.g., VALID, CANCELLED, USED
}

model BookedSeat {
  id          String   @id @default(cuid())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  seatNumber  String // e.g., "A1", "B4"
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String    @id
  email                   String    @unique
  name                    String
  hashed_password         String
  role                    Role
  busOwnerId              String?
  busOwner                BusOwner? @relation(fields: [busOwnerId], references: [id])
  passwordChangeRequired  Boolean   @default(false)
  sessions                Session[]
  auditLogs               AuditLog[]
}

model BusOwner {
  id                String           @id @default(cuid())
  name              String           @unique
  bankAccountNumber String           @unique
  buses             Bus[]
  admins            User[]
  locations         Location[]
  discounts         Discount[]
  commissionTiers   CommissionTier[]
}

model CommissionTier {
  id          String         @id @default(cuid())
  minSales    Float
  maxSales    Float
  type        CommissionType
  value       Decimal
  busOwnerId  String
  busOwner    BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

model Location {
  id             String    @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin   Route[]   @relation("OriginRoutes")
  routesDest     Route[]   @relation("DestinationRoutes")
  busRouteOrigin BusRoute[] @relation("BusRouteOrigin")
  busRouteDest   BusRoute[] @relation("BusRouteDestination")

  @@unique([name, ownerId])
}

model Bus {
  id       String    @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes   Route[]
  layout   SeatLayout?
  busRoute BusRoute?
}

model SeatLayout {
  id      String @id @default(cuid())
  rows    Int
  cols    Int
  busId   String @unique
  bus     Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  seats   Seat[]
}

model Seat {
  id          String   @id @default(cuid())
  seatNumber  String
  type        SeatType
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model BusRoute {
  id            String    @id @default(cuid())
  busId         String    @unique
  originId      String
  destinationId String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  origin        Location  @relation("BusRouteOrigin", fields: [originId], references: [id])
  destination   Location  @relation("BusRouteDestination", fields: [destinationId], references: [id])

  @@index([busId])
}

model Route {
  id             String    @id @default(cuid())
  departureTime  DateTime
  arrivalTime    DateTime
  price          Decimal
  originId       String
  destinationId  String
  origin         Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destination    Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  busId          String
  bus            Bus       @relation(fields: [busId], references: [id])
  bookings       Booking[]
  tickets        Ticket[]

  discountId              String?
  discount                Discount? @relation(fields: [discountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  ticketType              TicketType @default(ONE_WAY)
  roundTripDiscountType   DiscountValueType?
  roundTripDiscountValue  Decimal?
}

model Booking {
  id              String        @id @default(cuid())
  passengerName   String
  passengerPhone  String
  bookingTime     DateTime      @default(now())
  totalPrice      Decimal
  routeId         String
  route           Route         @relation(fields: [routeId], references: [id])
  tickets         Ticket[]
  paymentStatus   PaymentStatus @default(PENDING)
  expiresAt       DateTime?
  payments        Payment[]
}

model Ticket {
    id          String  @id @default(cuid())
    seatNumber  String
    status      TicketStatus @default(PENDING)
    bookingId   String
    booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    routeId     String
    route       Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

    @@index([bookingId])
    @@index([routeId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
}

model Discount {
  id         String         @id @default(cuid())
  name       String
  type       DiscountType
  percentage Decimal?
  startDate  DateTime
  endDate    DateTime
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tiers      DiscountTier[]
  routes     Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model ApiRequestAttempt {
    id          String @id @default(cuid())
    ipAddress   String
    timestamp   DateTime @default(now())

    @@index([ipAddress, timestamp])
}

model LoginAttempt {
    id          String @id @default(cuid())
    ipAddress   String
    timestamp   DateTime @default(now())

    @@index([ipAddress, timestamp])
}

model AuditLog {
    id          String      @id @default(cuid())
    userId      String?
    userName    String?
    userRole    Role?
    actionType  String
    description String
    details     Json?
    createdAt   DateTime    @default(now())
    ipAddress   String?
    user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([actionType])
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BOOKED
  LOCKED
}

enum TicketStatus {
  PENDING // Seat is reserved, awaiting payment
  VALID   // Payment confirmed, ticket is valid for travel
  USED    // Ticket has been scanned and used
  EXPIRED // The travel time has passed or booking expired
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  TICKET_COUNT_BASED
  DATE_BASED
}

enum DiscountValueType {
    PERCENTAGE
    FIXED
}

enum TicketType {
    ONE_WAY
    ROUND_TRIP
}

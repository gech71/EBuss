
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  admins          User[]           @relation("OwnerAdmins")
  commissionTiers CommissionTier[]
  locations       Location[]
  discounts       Discount[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CommissionTier {
  id        String          @id @default(cuid())
  ownerId   String
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id                  String  @id @default(cuid())
  name                String
  ownerId             String
  owner               BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin        Route[] @relation("OriginRoutes")
  routesDestination   Route[] @relation("DestinationRoutes")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id        String   @id @default(cuid())
  rows      Int
  cols      Int
  seats     Seat[]
  bus       Bus?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id          String     @id @default(cuid())
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String     @id @default(cuid())
  originId      String
  origin        Location   @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location   @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus        @relation(fields: [busId], references: [id])
  discountId    String?
  discount      Discount?  @relation(fields: [discountId], references: [id])
  bookings      Booking[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Discount {
  id         String         @id @default(cuid())
  name       String
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id])
  startDate  DateTime
  endDate    DateTime
  tiers      DiscountTier[]
  routes     Route[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  totalPrice     Decimal
  passengerName  String
  passengerEmail String
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
  bookedSeats    BookedSeat[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model BookedSeat {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ipAddress  String
  timestamp  DateTime @default(now())
}

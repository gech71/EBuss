
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String      @id @unique
  name            String
  email           String      @unique
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner?   @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
}

model BusOwner {
  id              String            @id @default(cuid())
  name            String            @unique
  commissionTiers CommissionTier[]
  buses           Bus[]
  admins          User[]            @relation("OwnerAdmins")
  discounts       Discount[]
  locations       Location[]
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Location {
  id             String  @id @default(cuid())
  name           String
  ownerId        String
  owner          BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin   Route[] @relation("OriginRoutes")
  routesDest     Route[] @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id])
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  routes   Route[]
  seatLayoutId String   @unique
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId   String
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  bookings      Booking[]
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  tiers     DiscountTier[]
  startDate DateTime
  endDate   DateTime
  routes    Route[]
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         String       @default("VALID")
}

model BookedSeat {
  id          String  @id @default(cuid())
  seatNumber  String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

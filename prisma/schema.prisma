
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  hashed_password String?
  role          Role      @default(CUSTOMER)
  busOwnerId    String?
  busOwner      BusOwner? @relation("admins", fields: [busOwnerId], references: [id])
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  buses           Bus[]
  locations       Location[]
  admins          User[]           @relation("admins")
  commissionTiers CommissionTier[]
  discounts       Discount[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Location {
  id              String  @id @default(cuid())
  name            String
  ownerId         String
  owner           BusOwner @relation(fields: [ownerId], references: [id])
  routesOrigin    Route[] @relation("OriginRoutes")
  routesDestination Route[] @relation("DestinationRoutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id])
  routes    Route[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id     String @id @default(cuid())
  rows   Int
  cols   Int
  seats  Seat[]
  bus    Bus?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus @default(AVAILABLE)
  type        SeatType   @default(SEAT)
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal      @db.Decimal(10, 2)
  bookingTime    DateTime     @default(now())
  status         BookingStatus @default(VALID)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model BookedSeat {
  id          String   @id @default(cuid())
  seatNumber  String
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Discount {
  id         String         @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id])
  tiers      DiscountTier[]
  routes     Route[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CommissionTier {
  id       String         @id @default(cuid())
  minSales Int
  maxSales Int
  type     CommissionType
  value    Decimal        @db.Decimal(10, 2)
  ownerId  String
  owner    BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ipAddress  String
  timestamp  DateTime @default(now())
}


enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  VALID
  CANCELLED
}

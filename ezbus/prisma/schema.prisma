
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String
  role            Role      @default(CUSTOMER)
  busOwnerId      String?
  busOwner        BusOwner? @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  admins          User[]           @relation("BusOwnerAdmins")
  buses           Bus[]
  discounts       Discount[]
  locations       Location[]
  commissionTiers CommissionTier[]

  @@map("bus_owners")
}

model CommissionTier {
  id      String         @id @default(cuid())
  ownerId String
  owner   BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  minSales Decimal
  maxSales Decimal
  type    CommissionType
  value   Decimal

  @@map("commission_tiers")
}

model Location {
    id String @id @default(cuid())
    name String
    ownerId String
    owner BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    originRoutes Route[] @relation("OriginRoutes")
    destinationRoutes Route[] @relation("DestinationRoutes")

    @@unique([name, ownerId])
    @@map("locations")
}


model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  ownerId  String
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  layout   SeatLayout  @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatLayoutId String   @unique
  routes   Route[]

  @@map("buses")
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?

  @@map("seat_layouts")
}

model Seat {
  id           String     @id @default(cuid())
  layoutId     String
  layout       SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber   String
  status       SeatStatus @default(AVAILABLE)
  type         SeatType

  @@map("seats")
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@map("routes")
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  routes    Route[]

  @@map("discounts")
}

model DiscountTier {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  minTickets Int
  maxTickets Int
  percentage Decimal

  @@map("discount_tiers")
}

model Booking {
  id             String       @id @default(cuid())
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  passengerName  String
  passengerEmail String
  status         String       @default("VALID")

  @@map("bookings")
}

model BookedSeat {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String

  @@map("booked_seats")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
  BLOCKED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

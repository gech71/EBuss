// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @unique
  name            String
  email           String  @unique
  hashed_password String?
  role            Role
  sessions        Session[]
  busOwnerId      String?
  busOwner        BusOwner? @relation("BusOwnerAdmins", fields: [busOwnerId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model BusOwner {
  id                 String           @id @default(cuid())
  name               String           @unique
  bankAccountNumber  String           @unique
  buses              Bus[]
  admins             User[]           @relation("BusOwnerAdmins")
  commissionTiers    CommissionTier[]
  locations          Location[]
  discounts          Discount[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Location {
  id                 String   @id @default(cuid())
  name               String
  ownerId            String
  owner              BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originRoutes       Route[]  @relation("OriginRoutes")
  destinationRoutes  Route[]  @relation("DestinationRoutes")

  @@unique([name, ownerId])
}

model CommissionTier {
  id         String         @id @default(cuid())
  minSales   Float          
  maxSales   Float
  type       CommissionType
  value      Decimal        @db.Decimal(10, 2)
  busOwnerId String
  busOwner   BusOwner       @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes    Route[]
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  seats Seat[]
  bus   Bus?
}

model Seat {
  id          String     @id @default(cuid())
  seatNumber  String
  status      SeatStatus
  type        SeatType
  layoutId    String
  layout      SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Restrict)
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Restrict)
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  tiers     DiscountTier[]
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routes    Route[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model DiscountTier {
  id          String   @id @default(cuid())
  minTickets  Int
  maxTickets  Int
  percentage  Decimal  @db.Decimal(5, 2)
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  passengerEmail String?
  totalPrice     Decimal       @db.Decimal(10, 2)
  status         BookingStatus
  paymentStatus  PaymentStatus
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  payments       Payment[]
  bookingTime    DateTime      @default(now())
}

enum BookingStatus {
  PENDING
  VALID
  CANCELLED
  USED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  transactionId   String        @unique
  referenceNumber String?
  paymentToken    String?       @unique
  status          PaymentStatus
  createdAt       DateTime      @default(now())
}

model BookedSeat {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber  String
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ipAddress   String
  timestamp   DateTime @default(now())
}

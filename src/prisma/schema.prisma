
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
}

model User {
  id              String    @id @unique
  email           String    @unique
  name            String
  hashed_password String?
  role            Role
  busOwnerId      String?
  busOwner        BusOwner? @relation("OwnerAdmins", fields: [busOwnerId], references: [id])
  sessions        Session[]
}

model Session {
  id        String   @id @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id                 String           @id @unique
  name               String           @unique
  bankAccountNumber  String           @unique
  buses              Bus[]
  admins             User[]           @relation("OwnerAdmins")
  commissionTiers    CommissionTier[]
  locations          Location[]
  discounts          Discount[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model CommissionTier {
  id         String   @id @default(cuid())
  busOwnerId String
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Decimal  @db.Decimal(10, 2)
  owner      BusOwner @relation(fields: [busOwnerId], references: [id], onDelete: Cascade)
}

model Location {
  id                  String   @id @default(cuid())
  name                String
  ownerId             String
  owner               BusOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routesOrigin        Route[]  @relation("OriginRoutes")
  routesDestination   Route[]  @relation("DestinationRoutes")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([name, ownerId])
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  routes    Route[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus
  type       SeatType
}

model Route {
  id            String    @id @default(cuid())
  originId      String
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal   @db.Decimal(10, 2)
  busId         String
  discountId    String?
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id], onDelete: Restrict)
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id], onDelete: Restrict)
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id             String        @id @default(cuid())
  passengerName  String
  passengerPhone String
  totalPrice     Decimal       @db.Decimal(10, 2)
  bookingTime    DateTime      @default(now())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  payments       Payment[]
  status         BookingStatus
  paymentStatus  PaymentStatus
}

model BookedSeat {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatNumber String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tiers     DiscountTier[]
  routes    Route[]
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal  @db.Decimal(5, 2)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  transactionId   String        @unique
  paymentToken    String?
  referenceNumber String?
  createdAt       DateTime      @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

model ApiRequestAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  timestamp DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum BookingStatus {
  PENDING
  VALID
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

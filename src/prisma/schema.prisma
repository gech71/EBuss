// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  hashed_password   String
  role              Role
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  busOwnerId        String?
  busOwner          BusOwner? @relation(fields: [busOwnerId], references: [id])
  sessions          Session[]
}

model Session {
	id        String   @id
	userId    String
	expiresAt DateTime
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  buses           Bus[]
  users           User[]
  discounts       Discount[]
  commissionTiers CommissionTier[]
}

model CommissionTier {
  id         String         @id @default(cuid())
  minSales   Float
  maxSales   Float
  type       CommissionType
  value      Float
  ownerId    String
  owner      BusOwner       @relation(fields: [ownerId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Bus {
  id        String      @id @default(cuid())
  name      String
  capacity  Int
  ownerId   String
  owner     BusOwner    @relation(fields: [ownerId], references: [id])
  layoutId  String      @unique
  layout    SeatLayout  @relation(fields: [layoutId], references: [id])
  routes    Route[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SeatLayout {
  id        String   @id @default(cuid())
  rows      Int
  cols      Int
  bus       Bus?
  seats     Seat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus
  type       SeatType
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([layoutId, seatNumber])
}

model Route {
  id            String    @id @default(cuid())
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  price         Float
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id])
  bookings      Booking[]
  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Float
  routeId        String
  route          Route        @relation(fields: [routeId], references: [id])
  bookedSeats    BookedSeat[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model BookedSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  seatNumber String
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  ownerId   String
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  tiers     DiscountTier[]
  routes    Route[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Float
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusOwner {
  id              String           @id @default(cuid())
  name            String           @unique
  commissionTiers CommissionTier[]
  admins          User[]
  buses           Bus[]
  locations       Location[]
  discounts       Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionTier {
  id        String          @id @default(cuid())
  owner     BusOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  minSales  Float
  maxSales  Float
  type      CommissionType
  value     Decimal
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  hashed_password String?
  busOwner        BusOwner? @relation(fields: [busOwnerId], references: [id])
  busOwnerId      String?
  role            Role      @default(USER)
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model Location {
  id           String  @id @default(cuid())
  name         String
  owner        BusOwner @relation(fields: [ownerId], references: [id])
  ownerId      String
  originRoutes Route[] @relation("OriginRoutes")
  destRoutes   Route[] @relation("DestinationRoutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, ownerId])
}

model Bus {
  id       String      @id @default(cuid())
  name     String
  capacity Int
  owner    BusOwner    @relation(fields: [ownerId], references: [id])
  ownerId  String
  layout   SeatLayout  @relation(fields: [layoutId], references: [id])
  layoutId String      @unique
  routes   Route[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatLayout {
  id    String @id @default(cuid())
  rows  Int
  cols  Int
  bus   Bus?
  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id         String     @id @default(cuid())
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  type       SeatType   @default(SEAT)
  layout     SeatLayout @relation(fields: [layoutId], references: [id])
  layoutId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum SeatType {
  SEAT
  AISLE
  DRIVER
}

model Route {
  id            String    @id @default(cuid())
  origin        Location  @relation("OriginRoutes", fields: [originId], references: [id])
  originId      String
  destination   Location  @relation("DestinationRoutes", fields: [destinationId], references: [id])
  destinationId String
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal
  bus           Bus       @relation(fields: [busId], references: [id])
  busId         String
  discount      Discount? @relation(fields: [discountId], references: [id])
  discountId    String?
  bookings      Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id             String       @id @default(cuid())
  passengerName  String
  passengerEmail String
  totalPrice     Decimal
  bookingTime    DateTime     @default(now())
  status         String
  route          Route        @relation(fields: [routeId], references: [id])
  routeId        String
  bookedSeats    BookedSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookedSeat {
  id         String  @id @default(cuid())
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  seatNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discount {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  owner     BusOwner       @relation(fields: [ownerId], references: [id])
  ownerId   String
  tiers     DiscountTier[]
  routes    Route[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountTier {
  id         String   @id @default(cuid())
  minTickets Int
  maxTickets Int
  percentage Decimal
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
